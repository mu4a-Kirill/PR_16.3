<Window x:Class="PR_14.Windows.RegistraciyaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="350" Width="300">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Регистрация" FontSize="20" Margin="0,0,0,20"/>

            <TextBlock Text="Login:" Margin="0,5"/>
            <TextBox x:Name="TextBoxLogin" Margin="0,0,0,10"/>

            <TextBlock Text="Password:" Margin="0,5"/>
            <PasswordBox x:Name="PasswordBoxParol" Margin="0,0,0,10"/>

            <TextBlock Text="Name:" Margin="0,5"/>
            <TextBox x:Name="TextBoxImya" Margin="0,0,0,10"/>

            <TextBlock Text="Surname:" Margin="0,5"/>
            <TextBox x:Name="TextBoxFamiliya" Margin="0,0,0,20"/>

            <Button x:Name="ButtonZaregistrirovatsya" Content="Зарегистрироваться" Click="ButtonZaregistrirovatsya_Click" Height="30"/>
        </StackPanel>
    </Grid>
</Window>