<Window x:Class="PR_14.Windows.SeansWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор места" Height="500" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Content="Вернуться" Click="ButtonNazad_Click" Margin="0,0,10,0"/>
            <TextBlock x:Name="TextBlockInfo" FontSize="16"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
            <CheckBox x:Name="CheckBoxSkritZanyatie" Content="Скрыть занятые места" Checked="CheckBoxSkritZanyatie_Checked" Unchecked="CheckBoxSkritZanyatie_Unchecked"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="10">
            <WrapPanel x:Name="WrapPanelMesta"/>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right">
            <TextBlock x:Name="TextBlockVibranoMesto" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button x:Name="ButtonOformit" Content="Оформить билет" Click="ButtonOformit_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>