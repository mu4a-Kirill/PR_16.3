<Window x:Class="PR_14.Windows.FilmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Film" Height="500" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Content="Назад" Click="ButtonNazad_Click" Margin="0,0,10,0"/>
            <TextBlock x:Name="TextBlockNazvanie" FontSize="24" FontWeight="Bold"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
            <Image x:Name="ImageFilm" Width="100" Height="150" Stretch="UniformToFill" 
       VerticalAlignment="Top" Margin="0,0,10,0"/>
            <StackPanel Margin="10,0,0,0">
                <TextBlock x:Name="TextBlockOpisanie" TextWrapping="Wrap" Width="400"/>
                <TextBlock x:Name="TextBlockReyting" Margin="0,5,0,0"/>
                <TextBlock x:Name="TextBlockVozrast" Margin="0,5,0,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Сеансы:" FontSize="16" FontWeight="Bold" Margin="10,20,0,10"/>

        <ListView Grid.Row="3" x:Name="ListViewSeansi" Margin="10,0,10,10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding DataSeansa, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                    <GridViewColumn Header="Время" DisplayMemberBinding="{Binding Vremya, StringFormat={}{0:hh\\:mm}}" Width="100"/>
                    <GridViewColumn Header="Зал" DisplayMemberBinding="{Binding ZalNomer}" Width="50"/>
                    <GridViewColumn Header="Сцена" DisplayMemberBinding="{Binding Cena, StringFormat={}{0} руб.}" Width="100"/>
                    <GridViewColumn Header="" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Выбрать" Click="ButtonVybratSeans_Click" Tag="{Binding Id}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>