<Window x:Class="PR_14.Windows.OformlenieBiletaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление билета" Height="400" Width="450">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Оформление билета" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Фильм: " Margin="0,5" FontWeight="Bold"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TextBlockFilm" Margin="5,5"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Зал: " Margin="0,5" FontWeight="Bold"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TextBlockZal" Margin="5,5"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата и время: " Margin="0,5" FontWeight="Bold"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TextBlockDataVremya" Margin="5,5"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Место: " Margin="0,5" FontWeight="Bold"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TextBlockMesto" Margin="5,5"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Сцена: " Margin="0,5" FontWeight="Bold"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TextBlockCena" Margin="5,5"/>
            </Grid>

            <Button x:Name="ButtonPodtverdit" Content="Подтвердить" Click="ButtonPodtverdit_Click" 
                    Height="30" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Window>