<Window x:Class="PR_14.Windows.LichnayaStranicaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Личный кабинет" Height="500" Width="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Content="Главная" Click="ButtonGlavnaya_Click" Margin="0,0,10,0"/>
            <TextBlock Text="Личный кабинет" FontSize="24" FontWeight="Bold"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="10">
            <TextBlock x:Name="TextBlockPolzovatel" FontSize="16" Margin="0,0,0,10"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="10">
            <TextBlock Text="Мои билеты:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <ListView x:Name="ListViewBileti">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Фильм" DisplayMemberBinding="{Binding FilmNazvanie}" Width="150"/>
                        <GridViewColumn Header="Зал" DisplayMemberBinding="{Binding ZalNomer}" Width="50"/>
                        <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding DataSeansa, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                        <GridViewColumn Header="Время" DisplayMemberBinding="{Binding Vremya, StringFormat={}{0:hh\\:mm}}" Width="100"/>
                        <GridViewColumn Header="Место" DisplayMemberBinding="{Binding Mesto}" Width="50"/>
                        <GridViewColumn Header="Сцена" DisplayMemberBinding="{Binding Cena, StringFormat={}{0} руб.}" Width="100"/>
                        <GridViewColumn Header="Дата заказа" DisplayMemberBinding="{Binding DataPokupki, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </Grid>
</Window>