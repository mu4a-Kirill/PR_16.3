<Window x:Class="PR_14.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кинотеатр" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Кинотеатр" FontSize="24" FontWeight="Bold"/>
            <Button x:Name="ButtonLichnayaStranica" Content="Личный кабинет" Margin="10,0,0,0" Click="ButtonLichnayaStranica_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
            <TextBox x:Name="TextBoxPoisk" Width="200" Margin="0,0,10,0" TextChanged="TextBoxPoisk_TextChanged"/>
            <ComboBox x:Name="ComboBoxSortirovka" Width="150" Margin="0,0,10,0" SelectionChanged="ComboBoxSortirovka_SelectionChanged">
                <ComboBoxItem Content="По названию"/>
                <ComboBoxItem Content="По рейтингу"/>
            </ComboBox>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="10">
            <ItemsControl x:Name="ItemsControlFilmi">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="10" Width="200">
                            <StackPanel>
                                <Image Source="{Binding Oblozhka}" Width="180" Height="200" Stretch="UniformToFill" 
                   VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Nazvanie}" FontWeight="Bold" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding Reyting, StringFormat=Reyting: {0}}"/>
                                <TextBlock Text="{Binding DataNachala, StringFormat=Data: {0:dd.MM.yyyy}}"/>
                                <TextBlock Text="{Binding VozrastnoyReyting, StringFormat=Vozrast: {0}+}"/>
                                <Button Content="Podrobnee" Margin="0,10,0,0" Click="ButtonPodrobnee_Click" Tag="{Binding Id}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>